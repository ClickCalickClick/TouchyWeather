// Proxy key template — the real key lives in secrets.js, which is gitignored
// so it never lands in the public repo.
//
// The build auto-creates secrets.js from this file when it's missing (see
// wscript), so a fresh clone compiles out of the box; proxy-backed features
// (radar, pollen, analytics) simply get 401s until a real key is supplied.
//
// PROXY_KEY is the Vercel proxy's RADAR_SECRET. Keep it URL-safe (no '#',
// '&', '@', etc.) — it's embedded directly in query strings, and values
// containing '#' get silently truncated at the fragment marker.
module.exports = { PROXY_KEY: '' };
